{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "sourceMap": false,
    "newLine": "LF",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2020"
    ]
  },
  "exclude": [
    "node_modules"
  ]
}
